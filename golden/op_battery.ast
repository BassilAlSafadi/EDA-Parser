(ND_MODULE "op_battery"
  (ports
    (ND_PORT "a" input [(ND_LITERAL 32'd3):(ND_LITERAL 32'd0)])
    (ND_PORT "b" input [(ND_LITERAL 32'd3):(ND_LITERAL 32'd0)])
    (ND_PORT "y1" output [(ND_LITERAL 32'd3):(ND_LITERAL 32'd0)])
    (ND_PORT "y2" output)
    (ND_PORT "y3" output [(ND_LITERAL 32'd3):(ND_LITERAL 32'd0)])
    (ND_PORT "y4" output [(ND_LITERAL 32'd7):(ND_LITERAL 32'd0)]))
  (items
    (ND_CONT_ASSIGN (ND_IDENT "y1") (ND_BINARY | (ND_BINARY & (ND_IDENT "a") (ND_IDENT "b")) (ND_BINARY ^ (ND_IDENT "a") (ND_IDENT "b"))))
    (ND_CONT_ASSIGN (ND_IDENT "y2") (ND_TERNARY (ND_BINARY === (ND_IDENT "a") (ND_IDENT "b")) (ND_UNARY & (ND_IDENT "a")) (ND_UNARY ~| (ND_IDENT "b"))))
    (ND_CONT_ASSIGN (ND_IDENT "y3") (ND_BINARY - (ND_BINARY + (ND_PART_SELECT (ND_IDENT "a") (ND_LITERAL 32'd3) (ND_LITERAL 32'd1)) (ND_CONCAT (ND_LITERAL 1'd0) (ND_PART_SELECT (ND_IDENT "b") (ND_LITERAL 32'd1) (ND_LITERAL 32'd0)))) (ND_BINARY << (ND_IDENT "a") (ND_LITERAL 32'd1))))
    (ND_CONT_ASSIGN (ND_IDENT "y4") (ND_REPLICATION (ND_LITERAL 32'd2) (ND_CONCAT (ND_IDENT "a"))))))
